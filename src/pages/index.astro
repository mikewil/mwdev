---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FluidVisual from '../components/FluidVisual.astro';
import { getPublishedProjects, getRecentWriting } from '../lib/content';

const [profiles, allProjects, allWriting] = await Promise.all([
  getCollection('profile'),
  getCollection('projects'),
  getCollection('writing'),
]);
const profile = profiles[0];
const projects = getPublishedProjects(allProjects);
const writing = getRecentWriting(allWriting);
const name = profile?.data.name ?? 'Your Name';
const headline = profile?.data.headline ?? 'Senior software engineer';
const links = [profile?.data.github, profile?.data.linkedin].filter(
  (link): link is string => Boolean(link),
);
---

<BaseLayout
  title={`${name} — Software Engineer`}
  description={`${headline}. A portfolio of selected work, ideas, and experiments.`}
>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label={`${name}, home`}>
      <img class="brand-logo" src="/mw-logo.svg" alt="" />
      <span>{name}</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#work">Work</a>
      <a href="#about">About</a>
      <a href="#writing">Notes</a>
      <a href="#contact">Contact</a>
    </nav>
    <span class="availability">Systems · teams · outcomes</span>
  </header>

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <FluidVisual />
      <div class="hero-inner shell">
        <div class="hero-copy">
          <p class="eyebrow section-label">{headline}</p>
          <h1 id="hero-title">
            I make complex things <span>feel clear.</span>
          </h1>
          <p class="hero-intro">
            Thoughtful software, considered systems, and a little room for
            wonder. This is a growing collection of work, ideas, and
            experiments.
          </p>
          <div class="hero-actions">
            <a class="button-link" href="#work">
              Explore selected work <span aria-hidden="true">↘</span>
            </a>
            <a class="text-link" href="#about">
              A little about me <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="hero-index">
          <span>Independent thinking · collaborative making</span>
          <span>01 — 03</span>
        </div>
      </div>
    </section>

    <section class="section shell" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <p class="eyebrow section-label">Selected work · 01</p>
        <h2 id="work-title">
          Good work makes <em>room for people.</em>
        </h2>
        <p>
          Case studies tell the story behind the shipped thing: what was hard,
          how the team moved through it, and what changed. Collecting those
          stories preserves the decisions and lessons behind the work while
          making its impact easier to see. That context gives collaborators a
          clearer picture of how I approach complex problems and help teams move
          them forward.
        </p>
      </div>
      {projects.length > 0 ? (
        <div class="work-grid">
          {projects.map((project, index) => (
            <a class="work-card" href={`/work/${project.id}/`}>
              <div class="work-card-top">
                <span>Case study · {String(index + 1).padStart(2, '0')}</span>
                {project.data.year && <span>{project.data.year}</span>}
                <span class="work-card-arrow" aria-hidden="true">
                  ↗
                </span>
              </div>
              {project.data.screenshot ? (
                <img
                  class="work-card-thumbnail"
                  src={project.data.screenshot.src}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              ) : (
                <span class="work-card-icon" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
              )}
              <div class="work-card-bottom">
                <div>
                  <h3>{project.data.title}</h3>
                  <p>{project.data.summary}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="draft-note">
          Your case studies are drafts in <code>src/content/projects/</code>.
          Publish them by setting <code>draft: false</code>.
        </p>
      )}
    </section>

    <section class="section shell" id="about" aria-labelledby="about-title">
      <div class="about-layout">
        <p class="eyebrow section-label">How I work · 02</p>
        <div class="about-copy">
          <h2 class="eyebrow" id="about-title">
            Curiosity with follow-through.
          </h2>
          <p>
            I have a passion for creating modern web applications and extensive
            experience leading solutions from concept through launch. I
            specialize in initiatives where strong UX and thoughtful
            architecture are equally important in delivering polished, scalable,
            and maintainable products.
          </p>
          <p>
            The best engineering balances rigor with imagination: strong
            foundations, useful details, and a healthy respect for the people on
            the other side of the interface.
          </p>
          <div class="principles" aria-label="Working principles">
            <div class="principle">
              <strong>01</strong>
              <span>Make the system legible</span>
            </div>
            <div class="principle">
              <strong>02</strong>
              <span>Leave things better</span>
            </div>
            <div class="principle">
              <strong>03</strong>
              <span>Stay curious</span>
            </div>
          </div>
          {links.length > 0 && (
            <p class="hero-actions">
              {links.map((link) => (
                <a
                  class="text-link"
                  href={link}
                  target="_blank"
                  rel="noreferrer"
                >
                  {new URL(link).hostname.replace('www.', '')}{' '}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </p>
          )}
        </div>
      </div>
    </section>

    <section class="section shell" id="writing" aria-labelledby="writing-title">
      <div class="section-heading">
        <p class="eyebrow section-label">Notes from the work · 03</p>
        <h2 id="writing-title">
          Ideas are better <em>when shared.</em>
        </h2>
        <p>
          Short notes on engineering, collaboration, and the unexpected places
          where technology meets design.
        </p>
      </div>
      {writing.length > 0 ? (
        <div class="work-grid">
          {writing.map((entry) => (
            <a class="work-card" href={`/writing/${entry.id}/`}>
              <div class="work-card-top">
                <span>
                  {entry.data.publishedAt.toLocaleDateString('en', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </span>
                <span>Note ↗</span>
              </div>
              {entry.data.image ? (
                <img
                  class="work-card-thumbnail"
                  src={entry.data.image.src}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                />
              ) : (
                <span class="work-card-icon" aria-hidden="true">
                  ✳
                </span>
              )}
              <div class="work-card-bottom">
                <div>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.summary}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="draft-note">
          Writing drafts live in <code>src/content/writing/</code> and appear
          here when published.
        </p>
      )}
    </section>

    <section class="contact" id="contact" aria-labelledby="contact-title">
      <div class="contact-inner shell">
        <div class="contact-intro">
          <p class="eyebrow section-label">Have a good problem?</p>
          <h2 id="contact-title">
            Let’s make something <em>matter.</em>
          </h2>
        </div>

        <div class="contact-form-layout">
          <form
            class="contact-form"
            id="contact-form"
            aria-label="Contact form"
            action="/contact.php"
            method="post"
          >
            <div class="contact-field">
              <label for="contact-name">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="120"
                required
                aria-describedby="contact-name-error"
              />
              <span class="contact-field-error" id="contact-name-error"></span>
            </div>
            <div class="contact-field">
              <label for="contact-email">Email Address</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="254"
                required
                aria-describedby="contact-email-error"
              />
              <span class="contact-field-error" id="contact-email-error"></span>
            </div>
            <div class="contact-field contact-field-message">
              <label for="contact-message">Message</label>
              <textarea
                id="contact-message"
                name="message"
                rows="6"
                maxlength="5000"
                required
                aria-describedby="contact-message-error"
              ></textarea>
              <span
                class="contact-field-error"
                id="contact-message-error"
              ></span>
            </div>
            <div class="contact-honeypot" aria-hidden="true">
              <label for="contact-website">Leave this field empty</label>
              <input
                id="contact-website"
                name="website"
                type="text"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="contact-form-actions">
              <p
                class="contact-feedback"
                data-contact-feedback
                role="status"
                aria-live="polite"
                aria-atomic="true"
              ></p>
              <button class="button-link" type="submit">
                Send
              </button>
            </div>
          </form>
          <img
            class="contact-mark"
            src="/mw-logo-orange.svg"
            alt=""
            aria-hidden="true"
            width="240"
            height="116"
          />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>
      © {new Date().getFullYear()} {name}
    </span>
    <span>Made with care and a little code</span>
    <a href="#top">Back to top ↑</a>
  </footer>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');

  if (form) {
    const feedback = form.querySelector<HTMLElement>('[data-contact-feedback]');
    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const fieldNames = ['name', 'email', 'message'] as const;

    const clearFieldError = (name: (typeof fieldNames)[number]) => {
      const field = form.elements.namedItem(name);
      const error = form.querySelector<HTMLElement>(`#contact-${name}-error`);
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement
      ) {
        field.removeAttribute('aria-invalid');
      }
      if (error) error.textContent = '';
    };

    for (const name of fieldNames) {
      form
        .querySelector<HTMLInputElement | HTMLTextAreaElement>(
          `[name="${name}"]`,
        )
        ?.addEventListener('input', (event) => {
          const field = event.currentTarget;
          if (
            field instanceof HTMLInputElement ||
            field instanceof HTMLTextAreaElement
          ) {
            field.setCustomValidity('');
          }
          clearFieldError(name);
          if (feedback) feedback.textContent = '';
        });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!feedback || !submitButton) return;

      for (const name of ['name', 'message'] as const) {
        const field = form.elements.namedItem(name);
        if (!(
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement
        )) {
          continue;
        }
        if (field.value.trim() === '') {
          field.setCustomValidity(
            name === 'name' ? 'Enter your name.' : 'Enter a message.',
          );
          field.reportValidity();
          field.focus();
          return;
        }
      }

      for (const name of fieldNames) clearFieldError(name);
      feedback.textContent = 'Sending your message…';
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        const result = (await response.json()) as {
          ok?: boolean;
          errors?: Partial<Record<(typeof fieldNames)[number], string>>;
        };

        if (!response.ok || !result.ok) {
          let hasFieldError = false;
          for (const name of fieldNames) {
            const errorText = result.errors?.[name];
            if (!errorText) continue;
            hasFieldError = true;
            const field = form.elements.namedItem(name);
            const error = form.querySelector<HTMLElement>(
              `#contact-${name}-error`,
            );
            if (
              field instanceof HTMLInputElement ||
              field instanceof HTMLTextAreaElement
            ) {
              field.setAttribute('aria-invalid', 'true');
            }
            if (error) error.textContent = errorText;
          }
          feedback.textContent = hasFieldError
            ? 'Please correct the highlighted fields and try again.'
            : 'Your message could not be sent. Please try again.';
          return;
        }

        form.reset();
        feedback.textContent = 'Thanks — your message has been sent.';
      } catch {
        feedback.textContent =
          'Your message could not be sent. Please check your connection and try again.';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send';
      }
    });
  }
</script>
